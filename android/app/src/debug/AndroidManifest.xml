<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds may talk to the local Flask server over plain HTTP
         (http://10.0.2.2:5000 in the emulator, or your computer's IP address).
         Release builds keep Android's default and need an HTTPS server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true"/>
</manifest>
